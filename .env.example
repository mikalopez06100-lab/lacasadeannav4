# === La Casa de Anna · Studio — variables d'environnement ===

# URL canonique du site (sans slash final)
NEXT_PUBLIC_SITE_URL=https://www.lacasadeanna.com

# Architecture marque mère (le 2e site Maison est branché ici quand il existe)
NEXT_PUBLIC_STUDIO_URL=https://www.lacasadeanna.com
NEXT_PUBLIC_MAISON_URL=https://mobilier.lacasadeanna.com

# Brevo — formulaire overlay CTA → séquence email bienvenue (API v3, côté serveur uniquement)
BREVO_API_KEY=
# ID de la liste Brevo vers laquelle pousser les contacts
BREVO_LIST_ID=

# Lien de prise de RDV consultation (Cal.com ou Google Calendar) — lien direct, pas de widget
NEXT_PUBLIC_BOOKING_URL=

# Google Business Profile — bloc avis dynamiques (Place API, côté client)
NEXT_PUBLIC_GOOGLE_PLACE_ID=
